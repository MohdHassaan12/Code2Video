      "learning_goal": "A triangle is drawn, its parts react, the formula grows, a question is asked.",
      "beats": [
        {"id": "01",
         "narration": "The wall is three metres high and the foot of the ladder is four metres out. How long is the ladder?",
         "thinking_pause_seconds": 5,
         "quiz": {"question": "How long is the ladder?", "options": ["7 metres", "5 metres", "12 metres"], "answer_index": 1, "explain": "Three squared plus four squared is twenty-five."},
         "figure": {"kind": "right_triangle", "a": 4, "b": 3, "labels": {"a": "4 m", "b": "3 m", "c": "?"}, "unknown": "c"},
         "steps": [
           {"say": "three metres high", "show": "b = 3\\text{ m}", "kind": "math", "focus": "b"},
           {"say": "four metres out", "show": "a = 4\\text{ m}", "kind": "math", "focus": "a"},
           {"say": "How long is the ladder", "show": "Find the slanted side", "kind": "key", "highlight": true, "focus": "c"}]},
        {"id": "02",
         "narration": "It is five metres. Build a square on each side. Nine plus sixteen is twenty-five, so the ladder is five metres.",
         "figure": {"kind": "right_triangle", "a": 4, "b": 3, "labels": {"a": "4", "b": "3", "c": "5"}, "squares": true, "result": "c"},
         "steps": [
           {"say": "square on each side", "show": "a^2 + b^2 = c^2", "kind": "math", "focus": "square_c"},
           {"say": "Nine plus sixteen", "show": "9 + 16 = 25", "kind": "math", "highlight": true, "focus": "square_a"},
           {"say": "five metres", "show": "c = 5\\text{ m}", "kind": "math", "focus": "square_c"}]}
      ]
    },
    {
