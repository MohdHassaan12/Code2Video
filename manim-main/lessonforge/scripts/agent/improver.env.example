# Copy to scripts/agent/improver.env (git ignores it) and set the paths for this server.

# The git checkout the live server runs from (the folder that holds lessonforge/).
LIVE_REPO=/home/you/manim
# The improver's own checkout (made by `improve.sh setup`). Never the live one.
WORKTREE=/home/you/manim-improver
# Branch new work starts from.
BASE_BRANCH=main
# The Python environment lessonforge is installed in (the live one is fine: PYTHONPATH points at the worktree).
VENV=/home/you/manim/lessonforge/.venv
# The LIVE server's workspace: the app's lesson list, the spend ledger and its budget, the library, the caches.
# The improver never makes a lesson here (testers would see it in the app). Its reports, logs and inbox go
# under $LIVE_HOME/improver/. (An improver.env from before 2026-10-15 named this LESSONFORGE_HOME; that still works.)
LIVE_HOME=/home/you/manim/lessonforge/lessonforge_workspace
# The improver's OWN workspace: the lessons it makes go here, never into the app's list. `improve.sh setup`
# links its library/ and cache/ (and models/) to the live ones, so teaching cards, drawings, the concept
# knowledge base, the speech cache and the stage store are shared and nothing is paid twice. Its spending
# goes on the live ledger, under the live cap ($LIVE_HOME/spend.jsonl, unless the live .env sets
# OPENROUTER_LEDGER). Default:
# IMPROVER_HOME=$LIVE_HOME/improver/home

# Most money one request may spend on lessons (OpenRouter), USD. About 0.10 to 0.15 per lesson.
IMPROVER_MAX_USD=1.00
# Most fix-and-remake rounds per request.
IMPROVER_ROUNDS=2
# The Claude model Claude Code itself uses (your plan): sonnet (lighter on usage limits) or opus.
CLAUDE_MODEL=sonnet
MAX_TURNS=200
