# Copy to .env and fill in the keys you have. The app tries providers in order:
#   Gemini  ->  Groq  ->  OpenRouter
# Set only the ones you want; a quota/rate-limit on one rolls over to the next.

# Primary: Google Gemini. Get a key at https://aistudio.google.com/apikey
# (the UI's API Settings panel also accepts a Gemini key per-request).
GEMINI_API_KEY=

# Fallback #1: Groq (fast, reliable free tier). https://console.groq.com/keys
GROQ_API_KEY=

# Fallback #2: OpenRouter (free models, often rate-limited). https://openrouter.ai/keys
OPENROUTER_API_KEY=

# Anthropic API (Claude), an alternative provider. https://console.anthropic.com/settings/keys
# Pick it in Studio ("LLM provider" -> Anthropic) or put it in the order below. Auto routing by cost:
#   storyboard -> claude-opus-5-5, code -> claude-sonnet-5-5, small calls and vision checks -> claude-haiku-5-5.
# A per-request key can also be sent in the X-Anthropic-API-Key header. Never commit the value.
ANTHROPIC_API_KEY=

# --- Provider order & limits ---
# LLM_PROVIDER_ORDER=gemini,openrouter,groq   # or gemini,groq,openrouter for speed-first
# The code task (scenes, drawings, repairs) asks OpenRouter first unless LLM_PROVIDER_ORDER is set: Gemini 2.5 Flash
# verified 4 of 8 scenes where Haiku 5.5 verified 8 of 8 (scripts/eval_scenes.py, 2026-10-15).
# LLM_PROVIDER_ORDER_CODE=openrouter,gemini,groq,anthropic
# Check every chain against OpenRouter's live catalogue (dead models, thinking models): scripts/check_models.py
# LLM_MAX_TOKENS=16000
# A call with no explicit ceiling (the storyboard) is sent with this large bounded one: OpenRouter answers 402 when
# the balance is under the worst case it prices from the model's own maximum, and a board of ~7+ scenes is >8k tokens.
# LLM_MAX_TOKENS_UNCAPPED=32000

# --- Optional model overrides (general/JSON steps) ---
# GEMINI_MODELS=gemini-2.5-flash,gemini-2.5-pro,gemini-2.0-flash
# OPENROUTER_MODELS=google/gemini-2.5-flash,deepseek/deepseek-v4-flash,mistralai/mistral-small-3.2-24b-instruct
# GROQ_MODELS=llama-3.3-70b-versatile,llama-3.1-8b-instant

# --- Optional per-task overrides for CODE steps (Manim/HTML codegen, repair, layout fix) ---
# OPENROUTER_CODE_MODELS=anthropic/claude-haiku-5.5,deepseek/deepseek-v4-flash,qwen/qwen3-coder-next   (measured: scripts/eval_scenes.py)
# GROQ_CODE_MODELS=llama-3.3-70b-versatile
# GEMINI_CODE_MODELS=gemini-2.5-flash

# --- Optional Anthropic chains (first model is tried first, the rest are failover) ---
# ANTHROPIC_MODELS=claude-haiku-5-5,claude-sonnet-5-5             # general / small calls (cheap)
# ANTHROPIC_VISION_MODELS=claude-haiku-5-5,claude-sonnet-5-5      # frame checks
# ANTHROPIC_CODE_MODELS=claude-sonnet-5-5,claude-haiku-5-5        # scene code and repairs
# ANTHROPIC_STORYBOARD_MODELS=claude-opus-5-5,claude-sonnet-5-5   # the plan every later step depends on
# How hard a 5.x model thinks per task (low|medium|high|xhigh|max); thinking tokens are billed as output:
# ANTHROPIC_EFFORT_STORYBOARD=high   ANTHROPIC_EFFORT_CODE=medium   ANTHROPIC_EFFORT_GENERAL=low   ANTHROPIC_EFFORT_VISION=low

# --- Other ---
# RENDER_TIMEOUT_SECONDS=600
# LAYOUT_REVIEW=1

# --- Metered calls through OpenRouter (lessonforge.spend) ---
# Hard budget in USD for everything this ledger records (chat, speech, speech-to-text, vision).
# OPENROUTER_BUDGET_USD=10
# Change it while a server runs with `lessonforge budget 20` or `lessonforge budget +10`: that writes
# budget.json next to the ledger (which wins over this line) and keeps this line in step.
# The key's lifetime usage (GET /api/v1/auth/key -> data.usage) when the budget was granted.
# OPENROUTER_USAGE_BASELINE=0
# The most ONE lesson may spend before its next call is refused. Unset: 2.5 times the lesson's estimate,
# at least 1.00 USD (a 3-minute lesson: 1.65). 0 switches the per-lesson ceiling off.
# LESSONFORGE_LESSON_MAX_USD=
# The most the KEY may spend in one UTC day, whoever spends it (a lesson, an eval script, a dev session).
# OPENROUTER_DAILY_USD=
# Ledger file (default <LESSONFORGE_HOME>/spend.jsonl). `lessonforge spend` prints it.
# OPENROUTER_LEDGER=
# Gemini 3.x reasons by default and bills it; "low" trims that where quality allows.
# OPENROUTER_REASONING_EFFORT=low
# Script writer chain (first that answers wins). Measured 2026-10-08: gemini-3.8-flash ~ $0.02 per 6-min script.
# HARNESS_WRITER_MODELS=google/gemini-3.8-flash,google/gemini-2.5-flash
# Gemini TTS for harness jobs: tier flash ($9/M audio tokens ≈ 1.4¢/min) or lite ($6/M ≈ 0.9¢/min), voice name.
# HARNESS_TTS_TIER=flash
# HARNESS_TTS_VOICE=Kore
# Delivery note passed to Gemini TTS (tone, pacing). Part of the audio cache key.
# LESSONFORGE_TTS_INSTRUCTIONS=A clear, warm teacher. Unhurried. Pause briefly after each question.
# Word-level alignment of narration via speech-to-text (default on when the key is set; 0 = off).
# LESSONFORGE_ALIGN=1
# Script critic: a different model FAMILY from the writer, so it does not accept its own mistakes.
# HARNESS_CRITIC_MODELS=anthropic/claude-haiku-5.5,openai/gpt-5.4-nano,deepseek/deepseek-v4-pro
# Vision review of one frame per beat after the render (1 = on when the key is set).
# HARNESS_VISION_REVIEW=1
# Intake questions written for the topic by a fast model (1 = on when the key is set). Chain: first that answers.
# HARNESS_INTAKE_LLM=1
# HARNESS_INTAKE_MODELS=google/gemini-3.5-flash-lite,google/gemini-2.5-flash,openai/gpt-5.4-nano
# Seconds to wait for one intake model before trying the next / falling back to the plain question.
# HARNESS_INTAKE_TIMEOUT=14

# Animated scenes for topics the figure inventory cannot draw are written by the 'code' chain:
# (default since 2026-10-15: Haiku 5.5 with thinking off, ~0.001 USD a scene; the old suggestion here,
#  gpt-5.6-terra/sonnet-5.5/deepseek-v4-pro, cost 10 to 40 times as much a scene)
# HARNESS_SCENE_WORKERS=3

# --- Exposing the server beyond localhost (Cloudflare quick tunnel for testing) ---
# Every request must then carry this as the X-Access-Token header or ?token= (cookie remembered).
# LESSONFORGE_ACCESS_TOKEN=
# Serve the exported web client at /app
# LESSONFORGE_WEB_APP=/path/to/clients/lessonforge-app/dist
# Then:  lessonforge serve   and   cloudflared tunnel --url http://127.0.0.1:5000 --protocol http2

# --- lessonforge ---
# Where everything written at runtime goes (renders, videos, caches). Default: ./lessonforge_workspace
# LESSONFORGE_HOME=/data/lessonforge
# Speech keys read by the engine's voice chain (primary -> Gemini TTS -> keyless gTTS):
# SARVAM_AI_KEY=
# Local long-form narration (pip install "lessonforge[kokoro]"); or put both files in $LESSONFORGE_HOME/models/
# KOKORO_MODEL=/path/to/kokoro-v1.0.onnx
# KOKORO_VOICES=/path/to/voices-v1.0.bin
# Font used by the long-form scene runtime (default Lato)
# LESSONFORGE_FONT=Lato
# Review-only secret for links given to students (GET /api/harness/jobs/{id}/review_link builds them).
# LESSONFORGE_REVIEW_TOKEN=

# --- The owner's own services (ask the owner for the addresses and keys; the addresses change) ---
# Drawing service: labelled diagrams for lessons (harness/diagrams.py).
# DIAGRAM_API_URL=
# DIAGRAM_API_KEY=
# Speech service: the first voice for Hindi, Hinglish and English (longform/speech.py, IndicBackend).
# INDIC_TTS_URL=
# INDIC_TTS_KEY=
# Web search for a lesson's sources (optional).
# TAVILY_API_KEY=

# --- More voices (2026-10-15; a lesson chooses one in the app's voice list, which shows what each costs) ---
# Microsoft's free online neural voices need only `pip install edge-tts` (in lessonforge[voices]); no key.
# Your own text-to-speech server: POST {"text","voice","language"} -> WAV or MP3 audio (speech.HttpBackend).
# TTS_HTTP_URL=
# TTS_HTTP_KEY=
# Its voice names, comma-separated, as offered in the app (empty: one entry, "Your server").
# TTS_HTTP_VOICES=

# --- The viewer site on Render (docs/DEPLOY_RENDER_VIEWER.md) ---
# On the GPU machine: the R2 four, so finished lessons are published (`lessonforge publish --all`, then by themselves).
# On Render: all of them, entered in its dashboard (deploy/render.yaml lists them), never in a file.
# CLOUDFLARE_ACCOUNT_ID=
# CLOUDFLARE_R2_BUCKET=
# CLOUDFLARE_R2_ACCESS_KEY_ID=
# CLOUDFLARE_R2_SECRET_ACCESS_KEY=
# CLOUDFLARE_D1_DATABASE_ID=
# CLOUDFLARE_API_TOKEN=
# or, instead of the token, the global key:
# CLOUDFLARE_EMAIL=
# CLOUDFLARE_API_KEY=
# 0: a lesson that finishes is not published by itself, and one removed is not taken off the site.
# LESSONFORGE_PUBLISH=1
# A folder that stands in for R2 and D1 (a trial on this machine, and the tests). Never the live workspace.
# LESSONFORGE_CLOUD_DIR=
# Optional on Render: the salt that hashes a cookieless visitor (default: derived from the R2 secret).
# LESSONFORGE_VISITOR_SALT=
