{
  "name": "lessonforge-renderer-ts",
  "private": true,
  "type": "module",
  "description": "TypeScript (Revideo) renderer for lessonforge chapters: reads lesson.json + timeline.json + audio, writes an mp4.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test test/*.test.ts",
    "input": "node scripts/make-input.mjs",
    "render": "node scripts/render.mjs"
  },
  "dependencies": {
    "@revideo/2d": "0.11.0",
    "@revideo/core": "0.11.0",
    "@revideo/renderer": "0.11.0",
    "@revideo/ui": "0.11.0",
    "@revideo/vite-plugin": "0.11.0"
  },
  "devDependencies": {
    "typescript": "5.6.3"
  }
}
